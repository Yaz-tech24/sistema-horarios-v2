# Copiar para ".env" no servidor de produção e preencher — nunca commitar
# o .env real (já está no .gitignore). Em desenvolvimento local no XAMPP
# não é preciso nenhum .env: config/db.php já tem os valores certos por
# omissão (localhost, base horarios_fagrenm, utilizador root sem password).

APP_ENV=producao

DB_HOST=localhost
DB_NAME=horarios_fagrenm
DB_USER=
DB_PASS=

# Vazio quando o domínio aponta diretamente para a pasta do projeto
# (típico numa VPS). Só usar algo como "/sistema-horarios-fagrenm" se
# o site viver numa subpasta do domínio.
BASE_URL=

# Porta do MySQL — deixar vazio/omitido usa a porta padrao 3306.
DB_PORT=

# Envio de email aos docentes quando um horário é publicado (opcional —
# sem SMTP_HOST, o sistema continua a funcionar normalmente só com as
# notificações internas, dentro do próprio site). Qualquer conta SMTP
# normal serve (Hostinger, Gmail com "palavra-passe de aplicação", etc.).
#   SMTP_PORT=465 -> SMTP_SECURE=ssl (TLS implícito, a ligação já nasce cifrada)
#   SMTP_PORT=587 -> SMTP_SECURE=tls (STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Sistema de Horarios FAGRENM
